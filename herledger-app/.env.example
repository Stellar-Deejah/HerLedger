# Node environment
NODE_ENV=development
# The canonical URL of the web application
APP_URL=http://localhost:3000
# PostgreSQL connection string
DATABASE_URL=postgresql://herledger:herledger@localhost:5432/herledger_dev
# PostgreSQL shadow database connection string (used for schema diffs in CI)
SHADOW_DATABASE_URL=postgresql://herledger:herledger@localhost:5432/herledger_shadow
# Secret key for auth session encryption (>= 64 hex chars / 32 bytes;
# generate one with: openssl rand -hex 32)
BETTER_AUTH_SECRET=05fddafc9c2b3b1a6a57ab04d3677c73f59779b7ba60aaf931a38672f93ccc78
# Resend API key, used to send verification emails (get one at https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Sender address for transactional email. In development, Resend's
# onboarding@resend.dev works without a verified domain; production needs a
# domain verified in the Resend dashboard.
EMAIL_FROM="HerLedger <onboarding@resend.dev>"
# Stellar network selection
STELLAR_NETWORK=testnet
# Soroban RPC endpoint URLs (comma-separated, primary first)
STELLAR_RPC_URLS=https://soroban-testnet.stellar.org
# Deprecated single RPC endpoint (still supported for backward compatibility)
# STELLAR_RPC_URL=https://soroban-testnet.stellar.org
# Horizon API endpoint URL
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
# Stellar network passphrase
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
# Contract ID for the Business Registry
BUSINESS_REGISTRY_CONTRACT_ID=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAABSC4
# Contract ID for the Financial Ledger
FINANCIAL_LEDGER_CONTRACT_ID=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAABSC4
# Contract ID for the Attestation Registry
ATTESTATION_REGISTRY_CONTRACT_ID=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAABSC4
# Internal URL for the indexer service
INDEXER_API_URL=http://localhost:4000
# Stellar network selection for the browser
NEXT_PUBLIC_STELLAR_NETWORK=testnet
# Soroban RPC endpoint URL for the browser
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
# Contract ID for the Business Registry (browser exposed)
NEXT_PUBLIC_BUSINESS_REGISTRY_CONTRACT_ID=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAABSC4
# Contract ID for the Financial Ledger (browser exposed)
NEXT_PUBLIC_FINANCIAL_LEDGER_CONTRACT_ID=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAABSC4
NEXT_PUBLIC_ATTESTATION_REGISTRY_CONTRACT_ID=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAABSC4

# --- Indexer tuning (optional — defaults shown) ---
# Grace period the shutdown handler waits for an in-progress sync batch to
# finish before force-exiting.  Increase if your sync cycles regularly take
# longer than 10 s.  Container orchestrators (Render, Kubernetes) should be
# configured with a terminationGracePeriodSeconds / stopTimeout that is at
# least SHUTDOWN_GRACE_MS + a few seconds to cover HTTP server drain time.
SHUTDOWN_GRACE_MS=10000

# Number of times connectWithRetry() retries a failed $connect() before
# exiting with a non-zero code (triggering an orchestrator restart).
DB_CONNECT_MAX_RETRIES=5

# Milliseconds between each connectWithRetry() attempt.
DB_CONNECT_RETRY_DELAY_MS=2000

# PostgreSQL statement_timeout appended to DATABASE_URL at runtime.
# Any query that runs longer than this is killed and logged as an error.
DB_STATEMENT_TIMEOUT_MS=10000
# Contract ID for the Attestation Registry (browser exposed)
NEXT_PUBLIC_ATTESTATION_REGISTRY_CONTRACT_ID=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAABSC4
# Indexer sync concurrency (wallets processed in parallel per replica)
SYNC_CONCURRENCY=5
# Wallet claim lease duration for multi-replica sync, in milliseconds
SYNC_LEASE_MS=60000
# Unique identifier for this indexer replica (used for claim locking)
INDEXER_INSTANCE_ID=indexer-1
