NODE_ENV=development
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://herledger:herledger@localhost:5432/herledger_dev
BETTER_AUTH_SECRET=dev-secret-must-be-at-least-32-characters-long
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
BUSINESS_REGISTRY_CONTRACT_ID=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAABSC4
FINANCIAL_LEDGER_CONTRACT_ID=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAABSC4
ATTESTATION_REGISTRY_CONTRACT_ID=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAABSC4
INDEXER_API_URL=http://localhost:4000
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_BUSINESS_REGISTRY_CONTRACT_ID=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAABSC4
NEXT_PUBLIC_FINANCIAL_LEDGER_CONTRACT_ID=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAABSC4
NEXT_PUBLIC_ATTESTATION_REGISTRY_CONTRACT_ID=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAABSC4

# --- Indexer tuning (optional — defaults shown) ---
# Grace period the shutdown handler waits for an in-progress sync batch to
# finish before force-exiting.  Increase if your sync cycles regularly take
# longer than 10 s.  Container orchestrators (Render, Kubernetes) should be
# configured with a terminationGracePeriodSeconds / stopTimeout that is at
# least SHUTDOWN_GRACE_MS + a few seconds to cover HTTP server drain time.
SHUTDOWN_GRACE_MS=10000

# Number of times connectWithRetry() retries a failed $connect() before
# exiting with a non-zero code (triggering an orchestrator restart).
DB_CONNECT_MAX_RETRIES=5

# Milliseconds between each connectWithRetry() attempt.
DB_CONNECT_RETRY_DELAY_MS=2000

# PostgreSQL statement_timeout appended to DATABASE_URL at runtime.
# Any query that runs longer than this is killed and logged as an error.
DB_STATEMENT_TIMEOUT_MS=10000