// HerLedger application database schema
// The database is an indexed application layer ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€šÃ‚Â NOT the source of truth for on-chain data.
// Blockchain-derived fields are immutable after indexing.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Better Auth ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€šÃ‚Â user and session models
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  /// @PII
  email         String    @unique
  emailVerified Boolean   @default(false)
  /// @PII
  name          String?
  /// @PII
  image         String?
  createdAt     DateTime  @default(now()) @db.Timestamptz
  updatedAt     DateTime  @updatedAt @db.Timestamptz
  deletedAt     DateTime? @db.Timestamptz

  sessions      Session[]
  accounts      Account[]
  businessProfile BusinessProfile?
  disputes      Dispute[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime @db.Timestamptz
  /// @PII
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                   String   @id @default(cuid())
  userId               String
  accountId            String
  providerId           String
  accessToken          String?
  refreshToken         String?
  accessTokenExpiresAt DateTime? @db.Timestamptz
  refreshTokenExpiresAt DateTime? @db.Timestamptz
  scope                String?
  idToken              String?
  password             String?
  createdAt            DateTime @default(now()) @db.Timestamptz
  updatedAt            DateTime @updatedAt @db.Timestamptz

  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz
  createdAt  DateTime @default(now()) @db.Timestamptz
  updatedAt  DateTime @updatedAt @db.Timestamptz

  @@unique([identifier, value])
  @@map("verifications")
}

// Better Auth's DB-backed rate limiter (rateLimit.storage: "database" in
// lib/auth/server.ts) -- one row per rate-limited key (e.g. an IP + route
// pair), reused as a sliding counter rather than one row per request.
// lastRequest is a millisecond epoch timestamp (Date.now()), which exceeds
// Int32 range -- must be BigInt, not Int.
model RateLimit {
  id          String @id @default(cuid())
  key         String
  count       Int
  lastRequest BigInt

  @@map("rate_limits")
}

// ---------------------------------------------------------------------------
// HerLedger application models
// ---------------------------------------------------------------------------

model BusinessProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  /// On-chain business ID (hex-encoded BytesN<32>)
  businessId    String   @unique
  /// Stellar address of the registered wallet
  /// @PII
  walletAddress String   @unique
  /// @PII
  displayName   String
  /// Hex-encoded metadata hash committed on-chain
  metadataHash  String
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @db.Timestamptz
  updatedAt     DateTime @updatedAt @db.Timestamptz

  user          User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  events        FinancialEvent[]

  @@index([walletAddress])
  @@index([businessId])
  @@map("business_profiles")
}

model FinancialEvent {
  id               String      @id @default(cuid())
  /// On-chain business ID (hex-encoded BytesN<32>)
  businessId       String
  /// On-chain event ID (hex-encoded BytesN<32>)
  eventId          String      @unique
  eventType        EventType
  /// Stellar asset contract address
  assetAddress     String
  /// Stored as string to preserve i128 precision ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€šÃ‚Â never cast to Number
  amount           String
  /// Stellar transaction hash (hex-encoded BytesN<32>)
  stellarReference String
  /// Hex-encoded metadata hash
  metadataHash     String
  status           EventStatus @default(Pending)
  ledgerSequence   Int
  createdAt        DateTime    @default(now()) @db.Timestamptz
  updatedAt        DateTime    @updatedAt @db.Timestamptz

  business         BusinessProfile @relation(fields: [businessId], references: [businessId], onDelete: Restrict)
  attestations     Attestation[]
  disputes         Dispute[]

  @@index([businessId])
  @@index([ledgerSequence])
  @@index([status])
  @@map("financial_events")
}

model Attestation {
  id              String            @id @default(cuid())
  /// On-chain attestation ID (hex-encoded BytesN<32>)
  attestationId   String            @unique
  /// On-chain event ID (hex-encoded BytesN<32>)
  eventId         String
  attesterAddress String
  claimHash       String
  /// Human-readable claim text the attester entered before it was hashed to
  /// `claimHash` (see CreateAttestationForm). Off-chain only -- the on-chain
  /// contract only ever sees the hash. Nullable because attestations synced
  /// by the indexer from raw on-chain data (rather than created through the
  /// app) have no description available. Never overwritten by the indexer's
  /// upsertAttestation, which only ever updates `status` -- see
  /// indexer/src/db/schema/attestations.ts and the matching write side in
  /// POST /api/attestations/[attestationId]/claim-description.
  claimDescription String?
  status          AttestationStatus @default(Active)
  ledgerSequence  Int
  createdAt       DateTime          @default(now()) @db.Timestamptz
  updatedAt       DateTime          @updatedAt @db.Timestamptz

  event           FinancialEvent    @relation(fields: [eventId], references: [eventId], onDelete: Restrict)

  @@index([eventId])
  @@index([attesterAddress])
  @@map("attestations")
}

// Off-chain profile for a registered attester, keyed by wallet address
// rather than a HerLedger userId. Attester registration is admin-gated
// on-chain (AttestationRegistry.register_attester requires the protocol
// admin's signature, not the attester's own -- see contracts/attestation_registry/src/lib.rs),
// so the party being registered does not need a HerLedger account at
// registration time; the wallet address is the only identity that has to
// exist. `active` mirrors the on-chain Attester.active flag and is what
// gates CreateAttestationForm visibility (see lib/attestations/attester-status.ts).
model AttesterProfile {
  id            String   @id @default(cuid())
  walletAddress String   @unique
  displayName   String
  description   String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @db.Timestamptz
  updatedAt     DateTime @updatedAt @db.Timestamptz

  @@index([walletAddress])
  @@map("attester_profiles")
}

// Off-chain record of a dispute raised against a FinancialEvent.
//
// The on-chain `dispute_event` call only ever receives a hash of the
// dispute reason (see `dispute_event(event_id, business_owner, reason_hash)`
// in the FinancialLedger contract) -- the plaintext reason itself has no
// on-chain home. This model is that off-chain home: it lets the business
// owner (and, in future, auditors) read back *why* a dispute was raised,
// and lets them reproduce `reasonHash` to verify it against the on-chain
// value on Stellar Expert.
//
// `reasonPlaintext` holds the AES-256-GCM ciphertext envelope, never the
// raw plaintext -- see apps/web/lib/crypto/dispute-encryption.ts. The field
// keeps the name "reasonPlaintext" (rather than e.g. "reasonCiphertext") to
// make the encrypt-at-write / decrypt-at-read contract explicit at the call
// site: every read of this column MUST go through decryptDisputeReason,
// and every write MUST go through encryptDisputeReason.
model Dispute {
  id               String        @id @default(cuid())
  /// On-chain event ID (hex-encoded BytesN<32>) this dispute was raised against
  eventId          String
  /// The HerLedger user (business owner) who raised the dispute
  userId           String
  /// AES-256-GCM ciphertext envelope of the dispute reason: "iv:authTag:ciphertext" (base64 segments).
  /// Never plaintext at rest -- see apps/web/lib/crypto/dispute-encryption.ts.
  reasonPlaintext  String
  /// Hash of the plaintext reason, matching the reason_hash submitted on-chain via dispute_event
  reasonHash       String
  status           DisputeStatus @default(Submitted)
  submittedAt      DateTime      @default(now()) @db.Timestamptz
  resolvedAt       DateTime?     @db.Timestamptz
  /// Stellar transaction hash of the on-chain resolve_dispute/revoke_event call, once known.
  /// Nothing in this PR populates it automatically (the indexer does not yet
  /// listen for dispute resolution contract events -- a pre-existing gap,
  /// see PR description); it is here so the "View resolution" UI action and
  /// a future indexer sync job have somewhere to read/write it.
  resolutionTxHash String?
  createdAt        DateTime      @default(now()) @db.Timestamptz
  updatedAt        DateTime      @updatedAt @db.Timestamptz

  event            FinancialEvent @relation(fields: [eventId], references: [eventId], onDelete: Restrict)
  user             User           @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([eventId])
  @@index([userId])
  @@index([status])
  @@map("disputes")
}

model StellarTransaction {
  /// Stellar transaction hash (hex string)
  hash           String   @id
  ledgerSequence Int
  successful     Boolean
  /// Stellar source account address
  sourceAddress  String
  createdAt      DateTime @default(now()) @db.Timestamptz

  @@index([ledgerSequence])
  @@index([sourceAddress])
  @@map("stellar_transactions")
}

model IndexerCheckpoint {
  id          String   @id @default(cuid())
  /// Logical stream identifier (e.g. "main", "business-events")
  stream      String   @unique
  lastLedger  Int
  updatedAt   DateTime @updatedAt @db.Timestamptz

  @@map("indexer_checkpoints")
}

// ---------------------------------------------------------------------------
// Enums ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€šÃ‚Â mirror on-chain definitions
// ---------------------------------------------------------------------------

enum EventType {
  PaymentReceived
  PaymentSent
  InvoiceSettled
  CommitmentFulfilled
}

enum EventStatus {
  Pending
  Verified
  Disputed
  Revoked
}

enum AttestationStatus {
  Active
  Revoked
}


/// Dead-letter table for events the indexer failed to process. Holds the
/// raw XDR so a fixed bug can be replayed via POST /v1/admin/replay/:errorId
/// instead of the event being lost. `resolvedAt` is set on successful
/// replay; unresolved rows accumulate a `retryCount` on each failed retry.
model IndexerError {
  id            String    @id @default(cuid())
  /// Public identifier used in the replay API path -- distinct from `id`
  /// so failed replays do not leak the internal cuid.
  errorId       String    @unique @default(cuid())
  /// Raw transaction XDR, needed to re-run parsing + indexing on replay.
  rawXdr        String
  /// Extra context needed to replay this event (e.g. walletAddress),
  /// stored as JSON since it varies by failure stage.
  context       Json?
  /// What stage failed (e.g. "parse", "index"), for grouping in metrics.
  stage         String
  message       String
  retryCount    Int       @default(0)
  resolvedAt    DateTime? @db.Timestamptz
  createdAt     DateTime  @default(now()) @db.Timestamptz
  updatedAt     DateTime  @updatedAt @db.Timestamptz

  @@index([stage])
  @@index([resolvedAt])
  @@map("indexer_errors")
}

// Off-chain dispute lifecycle. Coarser-grained on-chain state (EventStatus)
// only distinguishes Disputed / Verified / Revoked; this enum adds the
// Submitted -> Investigating refinement app-side. See
// apps/web/lib/disputes/status.ts for how the two are reconciled.
enum DisputeStatus {
  Submitted
  Investigating
  Resolved
  Revoked
}

model DataMigration {
  id        String   @id @default(cuid())
  name      String   @unique
  appliedAt DateTime @default(now()) @db.Timestamptz

  @@map("data_migrations")
}
