{
  "name": "herledger-app",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter web test:e2e",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "openapi:check": "tsx scripts/check-openapi-drift.ts",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema prisma/schema.prisma && tsx prisma/data-migrations/runner.ts",
    "db:migrate:dev": "prisma migrate dev --schema prisma/schema.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "env:validate": "pnpm --filter '@herledger/config' exec tsx --conditions react-server src/validate.ts",
    "changeset": "changeset",
    "postinstall": "node scripts/patch-typescript-eslint-ts-peer.mjs",
    "prepare": "cd .. && husky herledger-app/.husky"
  },
  "devDependencies": {
    "prettier": "3.4.2",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=20.19.0 || ^22.12.0 || >=24.0.0",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.9"
}
