{
  "name": "@herledger/sdk",
  "version": "0.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./contracts": {
      "types": "./src/contracts/index.ts",
      "default": "./src/contracts/index.ts"
    },
    "./wallet": {
      "types": "./src/wallet/index.ts",
      "default": "./src/wallet/index.ts"
    },
    "./rpc": {
      "types": "./src/rpc/index.ts",
      "default": "./src/rpc/index.ts"
    },
    "./types": {
      "types": "./src/types/index.ts",
      "default": "./src/types/index.ts"
    },
    "./errors": {
      "types": "./src/errors/index.ts",
      "default": "./src/errors/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run",
    "docs": "typedoc",
    "generate:abi": "node scripts/generate-abi-types.mjs",
    "generate:abi:check": "node scripts/generate-abi-types.mjs --check",
    "test:smoke": "TEST_AGAINST_TESTNET=true vitest run src/contracts/__tests__/smoke.testnet.test.ts"
  },
  "dependencies": {
    "@herledger/config": "workspace:*",
    "@stellar/freighter-api": "6.0.1",
    "@stellar/stellar-sdk": "16.2.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.10",
    "@vitest/coverage-v8": "4.1.10",
    "typedoc": "^0.28.20",
    "typescript": "7.0.2",
    "vite": "6.3.5",
    "vitest": "4.1.10"
  }
}
